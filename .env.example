# Copy to .env for local development. Expo inlines every EXPO_PUBLIC_* variable
# at bundle time, so these are fixed per build and none of them can hold a
# secret — anyone with the app can read them back out.

# Where the sync server lives. A development build will not start without this,
# and will not quietly fall back to the droplet: an unset variable would mean
# every account made while testing a sign-up landing in the production database.
# Point it at the dev server on this machine — server/README.md covers running
# one, including what WSL2 needs before a phone can reach it — or at
# https://authenticator.moates.com.au when production is genuinely the target.
#
# Release builds have no .env to read and go to the droplet.
EXPO_PUBLIC_SYNC_URL=http://192.168.1.10:8000

# Fills in the first factor on startup, so a reload does not mean retyping a
# passphrase and waiting several seconds for Argon2id. All three have to be set;
# any one of them missing leaves the normal sign-in screen in place.
#
# This is a real sign-in against EXPO_PUBLIC_SYNC_URL, not a bypass: the account
# is created on first run if it does not exist, and it stops at the code screen
# like any other sign-in. The code is emailed like any other — there is no
# console fallback — so use an address whose inbox you can get at.
#
# A device holding codes from another account will be asked before they are
# replaced — point this at a throwaway account, not your own.
# EXPO_PUBLIC_DEV_AUTO_LOGIN=1
# EXPO_PUBLIC_DEV_ACCOUNT_EMAIL=dev@example.com
# EXPO_PUBLIC_DEV_ACCOUNT_PASSPHRASE=a development passphrase

# Turns the app lock off, for simulators with nothing enrolled. The sync session
# still renews when the app is opened — there is simply no check in front of it,
# the same as on a device with no screen lock set up.
# EXPO_PUBLIC_DISABLE_APP_LOCK=1
