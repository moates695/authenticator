{
  "expo": {
    "name": "Authenticator",
    "slug": "authenticator",
    "scheme": "authenticator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E1014",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "au.com.moates.authenticator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.moates.authenticator_moates",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#0E1014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Authenticator uses the camera to scan two-factor QR codes.",
          "recordAudioAndVideo": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Authenticator uses Face ID to unlock your codes."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1014",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebd4a8c5-c003-440d-9ba7-28353ce09b01"
      }
    },
    "owner": "moates"
  }
}
