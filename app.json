{
  "expo": {
    "name": "Authenticator",
    "slug": "authenticator",
    "scheme": "authenticator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.moates.authenticator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.moates.authenticator",
      "adaptiveIcon": {
        "backgroundColor": "#0E1014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Authenticator uses the camera to scan two-factor QR codes.",
          "recordAudioAndVideo": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Authenticator uses Face ID to unlock your codes."
        }
      ]
    ]
  }
}
