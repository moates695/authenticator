# Copy to .env before the first `docker compose up`.
#
# Two secrets, neither of which opens a vault: the database password inside
# DATABASE_URL, and GOOGLE_REFRESH_TOKEN. The server stores a digest of each account's
# auth key and two wrapped copies of its data key, and cannot unwrap either — so
# the worst a stolen database gets an attacker is the list of addresses and a
# pile of ciphertext.

# --- The database ---------------------------------------------------------
#
# The PostgreSQL installed on the droplet, not a container: compose starts the
# app and nothing else, and the data lives under the system Postgres where the
# box's own backups and upgrades already reach it.
#
# `host.docker.internal` is the droplet itself, mapped to `host-gateway` in
# docker-compose.yml — the same address the other apps on the box use to reach
# the same install. So this is what production uses as written once the password
# is filled in. There is no default: a server that cannot reach its database
# should say so rather than open a local one.
#
# This file is not read in development at all: `npm run server` works its own URL
# out through deploy/dev_database_url.py, against the PostgreSQL installed on
# Windows.
DATABASE_URL=postgresql://authenticator:PASSWORD@host.docker.internal:5432/authenticator

# Connections held open. One uvicorn worker serving a few requests per device per
# day needs very few, and the ceiling has to leave room under the droplet
# Postgres's own max_connections, which this app shares with whatever else on the
# box uses it.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# How long a session survives without being used. It is a sliding window, not a
# deadline: the app calls /v1/session/refresh whenever the device's own unlock
# check is passed, which puts the full term back. A phone in daily use is asked
# for an emailed code once; one left alone for this long is asked again.
TOKEN_TTL_SECONDS=1209600

# Largest vault blob accepted, in bytes. A vault with a few hundred codes is well
# under 100KB, so this is generous while still stopping the box being used as
# free storage.
MAX_CIPHERTEXT_BYTES=1048576

# 0 means unlimited. Registration is open, so set a ceiling if the droplet starts
# filling up.
MAX_USERS=0

# Application-level throttles, underneath nginx's rate limiting.
MAX_LOGIN_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=900
MAX_REGISTRATIONS_PER_IP=5
REGISTRATION_WINDOW_SECONDS=3600

# --- The emailed second factor -------------------------------------------
#
# Where the six-digit codes are sent from. The server will not start without all
# three of these, because an account that cannot be sent a code cannot be signed
# into. That is true in development too: codes are never printed to the log, so
# the only address whose code is not really sent is the tester account below.
#
# Gmail, over its HTTP API rather than SMTP. Not a preference — the droplet's
# provider blocks outbound 25, 465 and 587 to every host, so a code sent over
# SMTP from production times out and the sign-up answers 502. Port 443 is open.
#
# The client id and secret come from an OAuth client of type "Desktop app" in the
# Google Cloud console, on a project with the Gmail API enabled. The refresh
# token is minted once, signed in as the sending mailbox:
#
#     uv run python deploy/google_oauth_token.py
#
# Get the consent screen published to "In production" first. Left in "Testing",
# Google expires every refresh token after seven days and codes stop a week
# later. See "The sending account" in README.md, and check the credentials with
# deploy/send_test_email.py before deploying them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail rewrites this to the mailbox the refresh token belongs to, unless it is a
# verified "Send mail as" alias of that mailbox. The angle brackets are required.
EMAIL_FROM=Authenticator <no-reply@authenticator.moates.com.au>

# How long the digits work for, and how long the user may keep asking for new
# ones before starting over from the passphrase. The second is deliberately
# longer than the first — see the README.
CODE_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=1800

# Wrong guesses before the challenge is destroyed. This, not the length of the
# code, is what makes six digits enough.
MAX_CODE_ATTEMPTS=5

# Codes sent within CODE_WINDOW_SECONDS. The per-email limit matters as much as
# the per-IP one: without it, anyone could use this to post mail to an address
# they do not own.
MAX_CODES_PER_EMAIL=5
MAX_CODES_PER_IP=20
CODE_WINDOW_SECONDS=900

# --- The tester account ---------------------------------------------------
#
# One address whose second factor is the fixed code 123456 instead of an emailed
# one, so app testers can sign in without access to an inbox. Leave it empty and
# there is no such address; every account is mailed.
#
# It is set to the same address in development and production — a tester account
# that only works on one of them is not a tester account — and the passphrase is
# still checked, so this is a one-factor account rather than an open door. The
# code itself is a constant in app/config.py rather than a setting: what the
# exception is should not be something a deployment can quietly change.
#
# TESTER_ACCOUNT.md in the repository root has the credentials and the reasoning.
TEST_ACCOUNT_EMAIL=test@app.com

# Set to 1 to expose /docs and /openapi.json while testing. Off in production: a
# public API explorer on an auth service is an invitation to poke at it.
ENABLE_DOCS=0
