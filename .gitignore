# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# generated test fixtures
scripts/fixtures.html

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files. EXPO_PUBLIC_* values are inlined into the bundle, so nothing
# here is a secret from anyone holding the app — but the development account's
# passphrase is still not something to commit.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# python bytecode, from the scripts under .claude/skills
__pycache__/
.pytest_cache/

# generated native folders. EAS builds them in the cloud from app.json, and a
# stale copy here would be prebuilt over anyway.
/ios
/android
